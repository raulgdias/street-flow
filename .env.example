# Used by docker compose. Copy to .env and replace every value marked CHANGE_ME.
POSTGRES_DB=streetflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# Optional production-style database configuration. Do not enable
# DB_AUTH_MODE=managed-identity locally unless you have authenticated with `az login`
# and created a Microsoft Entra PostgreSQL role for your user.
DB_AUTH_MODE=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=

# The API must use a policy with Send only. The worker must use a different
# policy with Listen only.
SERVICE_BUS_API_CONNECTION_STRING=
SERVICE_BUS_WORKER_CONNECTION_STRING=
SERVICE_BUS_ORDERS_TOPIC=pedidos
SERVICE_BUS_ORDERS_SUBSCRIPTION=processamento-pedidos
